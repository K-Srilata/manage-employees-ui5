<mvc:View
    controllerName="com.test.manageemployees.controller.View1"
    xmlns:mvc="sap.ui.core.mvc"
    displayBlock="true"
    xmlns="sap.m"
    xmlns:form="sap.ui.layout.form"
    xmlns:core="sap.ui.core"
>
    <Page
        id="form"
        title="Employee registration"
        showHeader="false"
    >
        <content>
            <form:SimpleForm
                id="simpleForm"
                editable="{viewModel>/editMode}"
                layout="ResponsiveGridLayout"
            >
                <Label
                    id="empid"
                    text="Employee Id"
                    required="true"
                />
                <Input
                    id="employeeId"
                    placeholder="Enter 2 digits"
                    maxLength="2" 
                    editable="{viewModel>/editMode}"
                    liveChange="onEmpIdLiveChange"
                />
                <Label
                    id="firstname"
                    text="First Name"
                    required="true"
                />
                <Input
                    id="firstName"
                    value="{Firstname}"
                    editable="{viewModel>/editMode}"
                />
                <Label
                    id="middlename"
                    text="Middle Name"
                />
                <Input
                    id="middleName"
                    value="{Middlename}"
                    editable="{viewModel>/editMode}"
                />
                <Label
                    id="lastname"
                    text="Last Name"
                    required="true"
                />
                <Input
                    id="lastName"
                    value="{Lastname}"
                    editable="{viewModel>/editMode}"
                />
                <Label
                    id="email"
                    text="Email Id"
                    required="true"
                />
                <Input
                    id="emailId"
                    type="Email"
                    value="{Emailid}"
                    editable="{viewModel>/editMode}"
                />
                <Label
                    id="phonenumber"
                    text="Phone Number"
                />
                <Input
                    id="phoneNumber"
                    type="Tel"
                    value="{Phonenumber}"
                    maxLength="10"
                    editable="{viewModel>/editMode}"
                />
                <Label
                    id="dept"
                    text="Department"
                    required="true"
                />
                <Input
                    id="department"
                    showValueHelp="true"
                    valueHelpRequest="onDeptHelp"
                    value="{Department}"
                    valueLiveUpdate="true"
                    showClearIcon="true"
                    change="onDeptChange"
                    editable="{viewModel>/editMode}"
                />
                <Label
                    id="date"
                    text="Start Date"
                />
                <DatePicker
                    id="startDate"
                    displayFormat="dd MMM yyyy"
                    valueFormat="yyyy-MM-dd"
                    dateValue="{Startdate}"
                    editable="{viewModel>/editMode}"
                />
                <Label
                    id="manager"
                    text="Manager"
                    required="true"
                />
                <!-- <Select
                    id="managerSelect"
                    items="{managerModel>/managers}"
                >
                    <items>
                        <core:Item
                            id="managerItem"
                            key="{managerModel>id}"
                            text="{managerModel>name}"
                            xmlns:core="sap.ui.core"
                        />
                    </items>
                    selectionChange="onManagerChange"
                </Select> -->
                <ComboBox
                    id="managerSelect"
                    items="{managerModel>/managers}"
                    placeholder="Select Manager"
                    showClearIcon="true"
                    selectedKey="{Manager}"
                    editable="{viewModel>/editMode}"
                    change="onManagerChange"
                >
                    <items>
                        <core:Item
                            id="managerItem"
                            key="{managerModel>name}"
                            text="{managerModel>name}"
                        />
                    </items>
                </ComboBox>
                <!-- it should be in footer -->
            </form:SimpleForm>
        </content>
        <footer>
            <Toolbar>
                <ToolbarSpacer />
                <Button
                    id="submit"
                    text="submit"
                    visible="{= ${viewModel>/mode} === 'create' }"
                    type="Emphasized"
                    press="onSubmit"
                />
                <Button
                    text="Delete"
                    type="Reject"
                    press="onDelete"
                    visible="{= ${viewModel>/mode} === 'edit' }"
                />

                <Button
                    text="{= ${viewModel>/editMode} ? 'Save' : 'Edit'}"
                    visible="{= ${viewModel>/mode} === 'edit' }"
                    press="onEditPress"
                />
                <Button
                    text="Reset"
                    type="Transparent"
                    press="onReset"
                    visible="{= ${viewModel>/mode} === 'create' || 
                    ${viewModel>/editMode}}"
                />
                <Button
                    text="Cancel"
                    type="Transparent"
                    press="onCancel"
                    visible="{= ${viewModel>/mode} === 'create' ||
                    ${viewModel>/editMode}}"
                />
            </Toolbar>
        </footer>
    </Page>
</mvc:View>
