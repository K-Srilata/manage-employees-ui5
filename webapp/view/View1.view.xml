<mvc:View
    controllerName="com.test.manageemployees.controller.View1"
    xmlns:mvc="sap.ui.core.mvc"
    displayBlock="true"
    xmlns="sap.m"
    xmlns:form="sap.ui.layout.form"
    xmlns:core="sap.ui.core"
>
    <Page
        id="form"
        title="Employee registration"
        showHeader="false"
    >
        <content>
            <form:SimpleForm
                id="simpleForm"
                editable="true"
                layout="ResponsiveGridLayout"
            >
                <Label
                    id="firstname"
                    text="First Name"
                    required="true"
                />
                <Input id="firstName" value="{employeeModel>/firstName}"/>
                <Label
                    id="middlename"
                    text="Middle Name"
                />
                <Input id="middleName" value="{employeeModel>/middleName}"/>
                <Label
                    id="lastname"
                    text="Last Name"
                    required="true"
                />
                <Input id="lastName" value="{employeeModel>/lastName}"/>
                <Label
                    id="email"
                    text="Email Id"
                    required="true"
                />
                <Input
                    id="emailId"
                    type="Email"
                    value="{employeeModel>/email}"
                />
                <Label
                    id="phonenumber"
                    text="Phone Number"
                />
                <Input
                    id="phoneNumber"
                    type="Tel"
                    value="{employeeModel>/phone}"
                    maxLength="10"
                />
                <Label
                    id="dept"
                    text="Department"
                    required="true"
                />
                <Input
                    id="department"
                    showValueHelp="true"
                    valueHelpRequest="onDeptHelp"
                    value="{employeeModel>/department}"
                    valueLiveUpdate="true"
                    showClearIcon="true"
                    change="onDeptChange"        
                />
                <Label
                    id="date"
                    text="Start Date"
                />
                <DatePicker
                    id="startDate"
                    displayFormat="dd MMM yyyy"
                    valueFormat="yyyy-MM-dd"
                    value="{employeeModel>/startDate}"
                />
                <Label
                    id="manager"
                    text="Manager"
                    required="true"
                />
                <!-- <Select
                    id="managerSelect"
                    items="{managerModel>/managers}"
                >
                    <items>
                        <core:Item
                            id="managerItem"
                            key="{managerModel>id}"
                            text="{managerModel>name}"
                            xmlns:core="sap.ui.core"
                        />
                    </items>
                    selectionChange="onManagerChange"
                </Select> -->
                <ComboBox
                    id="managerSelect"
                    items="{managerModel>/managers}"
                    placeholder="Select Manager"
                    showClearIcon="true"
                    selectedKey="{employeeModel>/manager}"
                    
                    change="onManagerChange"
                >
                    <items>
                        <core:Item
                            id="managerItem"
                            key="{managerModel>name}"
                            text="{managerModel>name}"
                        />
                    </items>
                </ComboBox>
                <!-- it should be in footer -->
            </form:SimpleForm>
        </content>
        <footer>
            <Toolbar>
                <ToolbarSpacer />
                <Button
                    id="submit"
                    text="Submit"
                    type="Emphasized"
                    press="onSubmit"
                />
                <Button
                    text="Reset"
                    type="Transparent"
                    press="onReset"
                />
                <Button
                    text="Cancel"
                    type="Transparent"
                    press="onCancel"
                />
            </Toolbar>
        </footer>
    </Page>
    
</mvc:View>
