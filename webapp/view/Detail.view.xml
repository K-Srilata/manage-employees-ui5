<mvc:View
    controllerName="com.test.manageemployees.controller.Detail"
    xmlns:l="sap.ui.layout"
    xmlns:core="sap.ui.core"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
>
    <!-- <Page id="pages" title="{i18n>title}">
        <content />
        <Button  id="helloWorldBtn" text="hello World"></Button>
        <Button
        press="onHelloHrBtnPress"
        id="btn"
        text="hello HR"
    />
        <Button press="helloWorldBtnPress" icon="sap-icon://nav-back" id="backBtn"></Button>
    </Page> -->
    <Table
        id="employeeList"
        items="{employeeModel>/employees}"
        growing="true"
    >
        <headerToolbar>
            <Toolbar id="tool">
                <Title
                    id="employee"
                    text="Employee List"
                />
                <ToolbarSpacer />
                <Button text="create new employee" press="onCreateNewEmployee" />
            </Toolbar>
        </headerToolbar>
        <columns>
            <Column>
                <Text text="Full Name" />
            </Column>
            <Column>
                <Text text="Email" />
            </Column>
            <Column>
                <Text text="Phone" />
            </Column>
            <Column>
                <Text text="Department" />
            </Column>
            <Column>
                <Text text="Start Date" />
            </Column>
            <Column>
                <Text text="Manager" />
            </Column>
        </columns>
        <items>
            <ColumnListItem>
                <cells>
                <!-- full name using formatter -->
                <Text text="{
                    parts: [
                        {path: 'employeeModel>firstName'},
                        {path: 'employeeModel>lastName'}
                    ],
                    formatter: '.formatter.formatFullName'
                }" />
                <!-- expression binding  -->
                <!-- <Text text="{= ${employeeModel>firstName} + ' ' + ${employeeModel>lastName} }" /> -->
                <Text text="{employeeModel>email}"></Text>
                <Text text="{employeeModel>phone}"></Text>
                <Text text="{employeeModel>department}"></Text>
                <Text text="{employeeModel>startDate}"></Text>
                <Text text="{employeeModel>manager}"></Text>
                </cells>
            </ColumnListItem>
        </items>
    </Table>
</mvc:View>
