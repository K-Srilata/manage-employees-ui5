<mvc:View
    controllerName="com.test.manageemployees.controller.Detail"
    xmlns:l="sap.ui.layout"
    xmlns:core="sap.ui.core"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
>
    <!-- <Page id="pages" title="{i18n>title}">
        <content />
        <Button  id="helloWorldBtn" text="hello World"></Button>
        <Button
        press="onHelloHrBtnPress"
        id="btn"
        text="hello HR"
    />
        <Button press="helloWorldBtnPress" icon="sap-icon://nav-back" id="backBtn"></Button>
    </Page> -->
    <Page
        showHeader="true"
        id="page"
        enableScrolling="true"
    >
        <Toolbar id="tool">
            <Title
                id="employee"
                text="Employee List"
            />
            <OverflowToolbar>
                <SearchField
                    liveChange=".onSearch"
                    width="200px"
                />
                <Button 
                    icon="sap-icon://sort" 
                    press="onSort" 
                    tooltip="Sort by Department" />
            </OverflowToolbar>
            <ToolbarSpacer />
            <!-- <SegmentedButton selectionChange="onToggleView">
                    <items>
                        <SegmentedButtonItem
                            text="Table View"
                            key="table"
                        />
                        <SegmentedButtonItem
                            text="List View"
                            key="list"
                        />
                    </items>
                </SegmentedButton> -->
            <ToggleButton
                id="toggleViewBtn"
                text="Show List View"
                press="onTogglePress"
            />
            <!-- <Switch 
                id="switchViewBtn"
                state="true"
                change="onSwitchChange"
                customTextOn="List"
                customTextOff="Table"/> -->
            <Button
                text="create new employee"
                press="onCreateNewEmployee"
            />
            <ToggleButton
                id="toggleButton"
                icon="sap-icon://lightbulb"
                pressed="false"
                press=".onThemeSwitch"
                width="50px"
                class="sapUiSmallMargin"
            />
        </Toolbar>
        <Table
            id="employeeTable"
            items="{path: '/Zemployee_tableSet', sorter:{path: 'Department',descending:false} }"
            growing="true"
        >
            <columns>
                <Column>
                    <Text text="Full Name" />
                </Column>
                <Column>
                    <Text text="Email" />
                </Column>
                <Column>
                    <Text text="Phone" />
                </Column>
                <Column>
                    <Text text="Department" />
                </Column>
                <Column>
                    <Text text="Start Date" />
                </Column>
                <Column>
                    <Text text="Manager" />
                </Column>
            </columns>
            <items>
                <ColumnListItem
                    press="onEmployeePress"
                    type="Navigation"
                >
                    <cells>
                        <!-- full name using formatter -->
                        <Text
                            text="{
                    parts: [
                        {path: 'Firstname'},
                        {path: 'Lastname'}
                    ],
                    formatter: '.formatter.formatFullName'
                    }"
                        />
                        <!-- expression binding  -->
                        <!-- <Text text="{= ${Firstname} + ' ' + ${Lastname} }" /> -->
                        <Text text="{Emailid}" />
                        <Text text="{Phonenumber}" />
                        <Text text="{Department}" />
                        <!-- <Text text="{Startdate}" /> -->
                        <Text text = " {
                            path : 'Startdate',
                            type : 'sap.ui.model.type.Date',
                            formatOptions : {
                                pattern : 'dd MM yyyy'
                            },
                            formatter: '.formatter.formatSeniority'
                        }" />
                        <Text text="{Manager}" />
                    </cells>
                </ColumnListItem>
            </items>
        </Table>

        <List
            id="employeelist"
            items="{/Zemployee_tableSet}"
            growing="true"
            visible="false"
        >
            <headerToolbar>
                <Toolbar id="listTool">
                    <!-- <Title
                    id="employeTable"
                    text="Employee List(List View)"
                /> -->
                    <HBox
                        class="sapUiSmallMarginBegin sapUiSmallMarginTopBottom"
                        width="100%"
                        justifyContent="SpaceBetween"
                    >
                        <Text text="Full Name" />
                        <Text text="Email" />
                        <Text text="Phone" />
                        <Text text="Department" />
                        <Text text="Start Date" />
                        <Text text="Manager" />
                    </HBox>
                </Toolbar>
            </headerToolbar>
            <items>
                <!-- <StandardListItem 
                title="{employeeModel>firstName}"/> -->
                <CustomListItem
                    press="onEmployeePress"
                    type="Active"
                >
                    <HBox
                        class="sapUiSmallMarginBegin sapUiSmallMarginTopBottom"
                        justifyContent="SpaceBetween"
                    >
                        <VBox>
                            <Text
                                text="{
                        parts : [
                            {path: 'Firstname'},
                            {path: 'Lastname'}
                        ],
                        formatter: '.formatter.formatFullName'
                        }"
                            />
                        </VBox>
                        <VBox>
                            <Text text="{Emailid}" />
                        </VBox>
                        <VBox>
                            <Text text="{Phonenumber}" />
                        </VBox>
                        <VBox>
                            <Text text="{Department}" />
                        </VBox>
                        <VBox>
                            <!-- <Text text="{Startdate}" /> -->
                            <Text text="{
                                path: 'Startdate',
                                type: 'sap.ui.model.type.Date',
                                formatOptions: {
                                    pattern: 'dd MMM yyyy'
                                }
                            }"/>
                        </VBox>
                        <VBox>
                            <Text text="{Manager}" />
                        </VBox>
                    </HBox>
                </CustomListItem>
            </items>
        </List>
    </Page>
</mvc:View>
