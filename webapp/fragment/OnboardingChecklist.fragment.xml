<core:FragmentDefinition xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:form="sap.ui.layout.form">
    <Dialog title="Onboarding Checklist">
        <content>
            <form:SimpleForm editable="true">
                <Label text="Paperwork" />
                <CheckBox 
                    selected="{= ${Paperwork} === 'X' }"
                    select="onPaperworkChange" />

                <Label text="Equipment Assignment" />
                <CheckBox 
                    selected="{= ${Equipment} === 'X' }"
                    select="onEquipmentChange" />

                <Label text="Orientation" />
                <CheckBox 
                    selected="{= ${Orientation} === 'X' }"
                    select="onOrientationChange" />

                <Label text="IT Access" />
                <CheckBox 
                    selected="{= ${Itaccess} === 'X' }"
                    select="onItAccessChange" />
            </form:SimpleForm>
        </content>
        <endButton>
            <Button text="Close" press="onCloseChecklist" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>

